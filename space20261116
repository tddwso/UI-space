<dialog id="modal">
  <div class="m-head">確認刪除？</div>
  <div class="m-body">此動作無法復原，請確認是否繼續。</div>
  <form method="dialog" class="m-foot">
    <button class="btn" value="cancel">取消</button>
    <button class="btn danger" value="ok">刪除</button>
  </form>
</dialog>
<div class="toasts" id="toasts" aria-live="polite"></div>

<script>
(function () {
  var root = document.documentElement;

  // Theme toggle (remember choice if storage is available)
  try { var saved = localStorage.getItem("theme"); if (saved) root.setAttribute("data-theme", saved); } catch (e) {}
  document.getElementById("themeBtn").addEventListener("click", function () {
    var isDark = root.getAttribute("data-theme") === "dark" ||
      (!root.getAttribute("data-theme") && matchMedia("(prefers-color-scheme: dark)").matches);
    var next = isDark ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("theme", next); } catch (e) {}
    renderSwatches();
  });

  // Color swatches read live from CSS variables
  function renderSwatches() {
    var names = ["--accent", "--success", "--warning", "--danger", "--bg-subtle", "--border", "--text", "--text-muted"];
    var cs = getComputedStyle(root), box = document.getElementById("swatches");
    box.innerHTML = names.map(function (n) {
      var v = cs.getPropertyValue(n).trim();
      return '<div class="swatch"><i style="background:var(' + n + ')"></i><span>' + n + '<br>' + v + '</span></div>';
    }).join("");
  }
  renderSwatches();

  // Toast
  function toast(msg) {
    var t = document.createElement("div");
    t.className = "toast"; t.textContent = msg;
    document.getElementById("toasts").appendChild(t);
    setTimeout(function () { t.remove(); }, 2600);
  }
  document.getElementById("toastBtn").addEventListener("click", function () { toast("✅ 已儲存變更"); });

  // Modal
  var modal = document.getElementById("modal");
  document.getElementById("openModal").addEventListener("click", function () { modal.showModal(); });
  modal.addEventListener("close", function () {
    if (modal.returnValue === "ok") toast("🗑️ 已刪除");
  });

  // Loading button
  var lb = document.getElementById("loadBtn");
  lb.addEventListener("click", function () {
    lb.disabled = true;
    lb.innerHTML = '<i class="spin"></i><span>載入中…</span>';
    setTimeout(function () { lb.disabled = false; lb.innerHTML = "<span>點我載入</span>"; toast("載入完成"); }, 1600);
  });

  // Range output
  var rg = document.getElementById("f-range");
  rg.addEventListener("input", function () { document.getElementById("rangeOut").textContent = rg.value; });

  // Progress
  var pv = 65;
  document.getElementById("pgBtn").addEventListener("click", function () {
    pv = pv >= 100 ? 0 : Math.min(100, pv + 15);
    document.getElementById("pg").style.width = pv + "%";
    document.getElementById("pgText").textContent = pv + "%";
    document.querySelector(".progress").setAttribute("aria-valuenow", pv);
  });

  // Tabs with keyboard support
  var tabs = Array.prototype.slice.call(document.querySelectorAll("#tabs .tab"));
  function select(i) {
    tabs.forEach(function (t, j) {
      var on = i === j;
      t.setAttribute("aria-selected", on);
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
    });
    tabs[i].focus();
  }
  tabs.forEach(function (t, i) {
    t.addEventListener("click", function () { select(i); });
    t.addEventListener("keydown", function (e) {
      if (e.key === "ArrowRight") select((i + 1) % tabs.length);
      if (e.key === "ArrowLeft") select((i - 1 + tabs.length) % tabs.length);
    });
  });

  // Side nav highlight
  var links = document.querySelectorAll("nav.side a");
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (en) {
      if (en.isIntersecting) {
        links.forEach(function (a) { a.classList.toggle("active", a.getAttribute("href") === "#" + en.target.id); });
      }
    });
  }, { rootMargin: "-30% 0px -60% 0px" });
  document.querySelectorAll("main section").forEach(function (s) { io.observe(s); });
})();
</script>
